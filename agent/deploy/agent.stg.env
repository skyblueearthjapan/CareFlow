# docker-compose.agent.yml の差し込み値（VPS の使い捨て試験環境・agent/staging と一緒に使う）。秘密は入れない。
# 本番の箱と同時に立てない（preflight.sh staging が確かめる）。
AGENT_ENV=staging
AGENT_NAME_PREFIX=stg
AGENT_RESTART=no
AGENT_PUBLIC_HOST_PORT=18211
AGENT_BACKEND_NETWORK=carelink-stg
AGENT_BACKEND_URL=http://stg-backend:8000/api/v1
AGENT_PG_HOST=stg-postgres
AGENT_PG_DB=carelink
AGENT_SANDBOX_SUBNET=172.31.251.0/24
AGENT_PUBLIC_ORIGIN=http://127.0.0.1:3000
AGENT_RELAY_SECRETS=/opt/carelink/agent-staging/agent-relay.env
AGENT_BACKUP_HOST_DIR=/opt/carelink/agent-staging/backups
AGENT_IMAGE_TAG=latest
CLAUDE_CODE_VERSION=2.1.296
CODEX_VERSION=0.162.1
# staging は試験のため有効（AGENT_ALLOWED_USER_IDS と機能の旗でさらに絞る）
AGENT_RELAY_ENABLED=1
