# docker-compose.agent.yml の差し込み値（本番）。秘密は入れない（秘密は /opt/carelink/secrets/agent-relay.env）。
AGENT_ENV=prod
AGENT_NAME_PREFIX=carelink
AGENT_RESTART=unless-stopped
AGENT_PUBLIC_HOST_PORT=18201
AGENT_BACKEND_NETWORK=deployment_default
AGENT_BACKEND_URL=http://carelink-backend:8000/api/v1
AGENT_PG_HOST=carelink-postgres
AGENT_PG_DB=carelink
AGENT_SANDBOX_SUBNET=172.31.250.0/24
AGENT_PUBLIC_ORIGIN=https://carelink.kaipoke-api.net
AGENT_RELAY_SECRETS=/opt/carelink/secrets/agent-relay.env
AGENT_BACKUP_HOST_DIR=/opt/carelink/backups/agent
AGENT_IMAGE_TAG=latest
CLAUDE_CODE_VERSION=2.1.296
CODEX_VERSION=0.162.1
# 全体の止め。PO の了承（README §2 P9）までは 0（公開口は healthz 以外 404）
AGENT_RELAY_ENABLED=0
