# build context = agent/（agent/deploy/Dockerfile.relay・Dockerfile.sandbox）
# 実行記録・バックアップ・試験の写し（利用者名入り）と秘密は image に入れない
runs/
**/runs/
staging/
tests/
relay/tests/
.omc/
.pytest_cache/
.ruff_cache/
**/__pycache__/
**/*.pyc
**/*.env
**/.env*
**/*.sql.gz
**/credentials*.json
**/token*.json
# deploy/ は runner 以外いらない
deploy/*
!deploy/runner/
