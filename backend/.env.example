# CareLink Backend - sample environment.
# Copy to `.env` and adjust for local docker-compose usage.
#
# 本番では `docs/deployment/env-template.md` の手順に従い、本ファイルと
# `frontend/.env.example` を統合した **`/opt/carelink/.env` (1 ファイル)** を作成する。
# 開発時は本ファイルを `backend/.env` にコピーして使用する。

# --- App ---
APP_ENV=development
APP_NAME=CareLink Backend
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,https://carelink.kaipoke-api.net

# --- Database ---
# In docker-compose, hostname is the postgres service name.
DATABASE_URL=postgresql+asyncpg://carelink:carelink@postgres:5432/carelink
DATABASE_ECHO=false
# Postgres container 用 (compose の env_file から `${POSTGRES_*}` を参照)。
# 本番は `openssl rand -base64 18 | tr -d '/+=' | cut -c1-24` で強いパスワードに置換。
POSTGRES_USER=carelink
POSTGRES_PASSWORD=carelink
POSTGRES_DB=carelink

# --- JWT ---
# Override JWT_SECRET in production (min 32 chars).
JWT_SECRET=please-change-me-to-a-strong-random-string-32chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_SECONDS=3600
JWT_REFRESH_TTL_SECONDS=2592000

# --- External APIs (optional, used by /geocode and /ai) ---
# Google Maps Geocoding API key — required for POST /api/v1/geocode
# (Wave 4-C). When empty, /geocode returns 502 with "GOOGLE_MAPS_API_KEY
# is not configured". Restrict the key to the Geocoding API + your
# server IP in the Google Cloud console.
GOOGLE_MAPS_API_KEY=
# Gemini API key — required for POST /api/v1/ai/interpret (Wave 4-B). When
# empty, the endpoint returns 503 and still records a row in
# ai_interpret_logs for forensics. Use a Google AI Studio key for dev,
# Google Cloud (Vertex) for production.
GEMINI_API_KEY=
# Gemini model id used by /ai/interpret. Default tracks the current GA
# flash tier; bump when Google retires it (1.5-flash returned 404 on
# v1beta in 2026-Q2). Alternatives: gemini-2.5-flash, gemini-1.5-pro.
GEMINI_MODEL=gemini-2.0-flash

# --- Integrations forward target (D4 worker) ---
INTEGRATION_BASE_URL=http://integrations:8001

# --- Kaipoke API relay (Wave 4-A) ---
# Existing Flask + Playwright service that drives kaipoke.com.
# Token is a long random string shared with the kaipoke-api worker.
KAIPOKE_API_BASE_URL=https://kaipoke-api.net
KAIPOKE_API_TOKEN=
# Local directory for /export job CSV cache (TTL controlled below).
KAIPOKE_EXPORT_DIR=/tmp/carelink/exports
KAIPOKE_EXPORT_TTL_SECONDS=1800

# --- Visit photo storage (Wave 4-D) ---
# Host bind-mount target for photos uploaded via
# POST /api/v1/visits/{id}/photos. Inside the backend container this MUST
# be writable by the `app` user (UID set in Dockerfile). On the host,
# create the directory before `docker compose up` and chown to match the
# container UID so the bind-mount round-trips. Files are laid out as
#   {VISIT_PHOTOS_DIR}/{visit_id}/{photo_uuid}.{jpg|png|webp}
# and the DB row in `visit_photos` carries the absolute path.
VISIT_PHOTOS_DIR=/opt/carelink/data/visit_photos
